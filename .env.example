# Copier en .env.local (jamais commité). Variables serveur uniquement.

# --- Mode local (sans Supabase) : npm run db, puis npm run dev ---
AUTH_MODE=local
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/postgres
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SECRET_SESSION_LOCALE=

# --- Mode Supabase (préproduction / production) ---
# AUTH_MODE=supabase
# DATABASE_URL=postgres://postgres.<ref>:<mot-de-passe>@aws-0-eu-west-3.pooler.supabase.com:6543/postgres
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_PUBLISHABLE_KEY=

# --- Rappels mail (tous modes) ---
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=
APP_URL=http://localhost:3000
# local : mails écrits dans .data/mails (consultables dans Paramètres) · resend : envoi réel (production)
MAIL_MODE=local
# RESEND_API_KEY=
# MAIL_EXPEDITEUR=Jalon <rappels@votre-domaine.fr>
